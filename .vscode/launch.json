{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug alarm_clock",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/alarm_clock.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "preLaunchTask": "CMake: build",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
